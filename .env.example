# Copy to .env and edit. Every setting is optional — the defaults run the app
# locally on Apple Silicon with the MLX model built by `make model`.
# See backend/src/klam/config.py for the full list.

# --- Speech recognition -----------------------------------------------------
# mlx       local, on Apple Silicon (the default)
# mock      fixed text, no model and no GPU — for working on the UI
# voxtral   a remote OpenAI-compatible endpoint, e.g. deploy/modal
# local-gpu in-process on a CUDA GPU (needs the `local-gpu` extra)
KLAM_ASR_PROVIDER=mlx
# auto | ar | fr | en
KLAM_LANGUAGE=auto

# A local directory or a Hugging Face repo id. The default is what `make model`
# produces.
# KLAM_MLX_MODEL=~/models/voxtral-ar-8bit
# ...or a published conversion, which is downloaded on first use:
# KLAM_MLX_MODEL=abdeljalilELmajjodi/voxtral-ar-8bit-mlx

# --- Remote transcription (KLAM_ASR_PROVIDER=voxtral) ------------------------
# Note that using this sends your audio off the machine, which the upload
# screen's "nothing is uploaded anywhere" line does not cover.
# KLAM_VOXTRAL_BASE_URL=https://<workspace>--klam-asr-web.modal.run
# KLAM_VOXTRAL_API_KEY=<the Modal KLAM_ASR_TOKEN>

# --- Storage and export -----------------------------------------------------
# Where uploads, exports and the job database live.
# KLAM_DATA_DIR=data
# Only needed if a libass-capable FFmpeg is not on PATH — `make doctor` says.
# KLAM_FFMPEG_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
